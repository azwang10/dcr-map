{
  "version": 8,
  "name": "DCR Style",
  "metadata": {"maputnik:renderer": "mlgljs"},
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "contours": {
      "type": "vector",
      "tiles": [
        "dem-contour://{z}/{x}/{y}?contourLayer=contours&elevationKey=ele&levelKey=level&multiplier=3.28084&overzoom=1&thresholds=11*10"
      ],
      "maxzoom": 15
    },
    "hillshade": {
      "type": "raster-dem",
      "encoding": "terrarium",
      "tiles": ["dem-shared://{z}/{x}/{y}"],
      "maxzoom": 12,
      "tileSize": 256
    }
  },
  "glyphs": "glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "bg",
      "type": "background",
      "paint": {"background-color": "rgba(168, 189, 179, 1)"}
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {"fill-color": "rgba(253, 254, 255, 1)"}
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "hillshade",
      "paint": {
        "hillshade-exaggeration": 0.65,
        "hillshade-shadow-color": "rgba(0, 55, 40, 0.55)",
        "hillshade-highlight-color": "rgba(255, 255, 255, 0.3)",
        "hillshade-accent-color": "rgba(0, 55, 40, 0.22)"
      }
    },
    {
      "id": "contour",
      "type": "line",
      "source": "contours",
      "source-layer": "contours",
      "minzoom": 11,
      "paint": {
        "line-color": "rgba(0, 102, 73, 0.3)",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.3, 16, 0.8]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {"fill-color": "rgba(137, 168, 155, 1)"}
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {"line-color": "rgba(137, 168, 155, 1)", "line-width": 2}
    },
    {
      "id": "path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "class", "path"],
        ["!=", "bicycle", "yes"]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "rgba(0, 102, 73, 1)",
        "line-dasharray": [0, 2],
        "line-width": 4
      }
    },
    {
      "id": "bike",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", "class", "path"], ["==", "bicycle", "yes"]],
      "paint": {
        "line-color": "rgba(0, 102, 73, 1)",
        "line-dasharray": [0.2, 0.6],
        "line-width": 6
      }
    },
    {
      "id": "track-outside",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "track"],
      "paint": {"line-color": "rgba(0, 102, 73, 1)", "line-width": 5}
    },
    {
      "id": "track-inside",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "track"],
      "paint": {"line-color": "rgba(255, 255, 255, 1)", "line-width": 3}
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["!=", "class", "path"],
        ["!=", "class", "ferry"],
        ["!=", "class", "track"],
        ["!=", "class", "rail"],
        ["!=", "class", "aerialway"]
      ],
      "paint": {"line-color": "rgba(0, 102, 73, 1)", "line-width": 4}
    },
    {
      "id": "water-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "text-field": "{name}",
        "text-font": ["Stone Sans Italic"],
        "text-size": 12
      },
      "paint": {"text-color": "rgba(0, 102, 73, 1)"}
    },
    {
      "id": "way-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary",
        "tertiary",
        "minor",
        "track",
        "path"
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Stone Sans"],
        "text-size": 12,
        "text-offset": [0, 1]
      },
      "paint": {"text-color": "rgba(0, 102, 73, 1)"}
    }
  ],
  "id": "wv8vyus"
}